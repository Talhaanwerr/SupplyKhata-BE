<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Verify your email</title>
  </head>
  <body style="margin:0;padding:0;background:#f4f4f5;font-family:Arial,Helvetica,sans-serif;color:#18181b;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background:#f4f4f5;padding:32px 16px;">
      <tr>
        <td align="center">
          <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="max-width:560px;background:#ffffff;border-radius:8px;padding:32px;">
            <tr>
              <td>
                <h1 style="margin:0 0 8px;font-size:20px;font-weight:700;">{{appName}}</h1>
                <p style="margin:0 0 24px;font-size:14px;color:#71717a;">Verify your email</p>
                <p style="margin:0 0 16px;font-size:15px;line-height:1.5;">Hi {{firstName}},</p>
                <p style="margin:0 0 16px;font-size:15px;line-height:1.5;">
                  Please verify your email address to activate your account. This link expires in 24 hours.
                </p>
                <p style="margin:0 0 24px;">
                  <a
                    href="{{verifyLink}}"
                    style="display:inline-block;background:#18181b;color:#ffffff;text-decoration:none;padding:12px 20px;border-radius:6px;font-size:14px;font-weight:600;"
                  >
                    Verify email
                  </a>
                </p>
                <p style="margin:0;font-size:13px;line-height:1.5;color:#71717a;word-break:break-all;">
                  Or copy this link:<br />{{verifyLink}}
                </p>
                <p style="margin:32px 0 0;font-size:12px;color:#a1a1aa;">
                  If you did not request this email, you can safely ignore it.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
