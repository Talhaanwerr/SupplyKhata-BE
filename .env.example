# ─── Application ──────────────────────────────────────────────
NODE_ENV=development
PORT=4700
API_PREFIX=api/v1

# ─── Database ─────────────────────────────────────────────────
DATABASE_URL="mysql://root:password@localhost:3306/saas_db"

# ─── JWT ──────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# ─── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed origins (frontend).
# In non-prod with Swagger enabled, http://localhost:PORT is also allowed automatically.
CORS_ORIGINS=http://localhost:3010

# ─── Rate Limiting ────────────────────────────────────────────
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# ─── Swagger ──────────────────────────────────────────────────
# Set to 'false' to disable Swagger in production
SWAGGER_ENABLED=true

# ─── Logging ──────────────────────────────────────────────────
LOG_LEVEL=debug

# ─── Auth ─────────────────────────────────────────────────────
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ─── Mail (Mailtrap Sending — use a real API token in MAIL_PASS) ─
# Railway often blocks outbound 587; if emails hang/timeout, try MAIL_PORT=2525
MAIL_HOST=live.smtp.mailtrap.io
MAIL_PORT=587
MAIL_USER=api
MAIL_PASS=your_mailtrap_api_token
MAIL_FROM=hello@demomailtrap.co
MAIL_FROM_NAME=SupplyKhata

# ─── Frontend ─────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3010

# Required: absolute API base for avatar/file links and public URLs
API_PUBLIC_URL=http://localhost:4700

STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# S3 — only required when STORAGE_DRIVER=s3
# Leave these empty (or commented out) when using local storage
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=
