generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────

enum TenantStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum MemberStatus {
  INVITED
  ACTIVE
  INACTIVE
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum BillingCycle {
  MONTHLY
  YEARLY
  LIFETIME
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

enum PaymentCycle {
  CASH_ON_DELIVERY
  WEEKLY
  FORTNIGHTLY
  MONTHLY
  CUSTOM
}

/// Sale / stock math is always in this unit (PCS | LTR | KG).
enum ProductBaseUnit {
  PCS
  LTR
  KG
}

enum VehicleStatus {
  ACTIVE
  INACTIVE
}

enum StockType {
  OPENING
  CLOSING
}

enum RunStatus {
  OPEN
  CLOSED
}

enum PaymentMethod {
  CASH
  BANK
  EASYPAISA
  JAZZCASH
  OTHER
}

enum DeliveryStatus {
  DELIVERED
  PARTIAL
  FAILED
  CANCELLED
}

enum PlannedStopStatus {
  PLANNED
  INCLUDED
  COMPLETED
  SKIPPED
  FAILED
  CANCELLED
}

enum PlannedStopSource {
  SCHEDULE
  MANUAL
}

enum ContainerMovementType {
  DELIVERED_TO_CUSTOMER
  RETURNED_FROM_CUSTOMER
  LOADED_TO_VEHICLE
  UNLOADED_FROM_VEHICLE
  LOST
  DAMAGED
  ADJUSTMENT
  OPENING_WITH_CUSTOMER
  OPENING_ON_HAND
}

enum CollectionVisitOutcome {
  COLLECTED
  PARTIAL
  PROMISED
  NO_CONTACT
  SKIPPED
}

enum OrderStatus {
  DRAFT
  PLACED
  SHIPPED
  PARTIALLY_DELIVERED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum OrderPaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  VOID
}

enum InvoicePeriodType {
  WEEKLY
  MONTHLY
  CUSTOM
}

enum InvoiceLineType {
  OPENING
  DELIVERY
  ORDER
  ORDER_FEE
  PAYMENT
  ADJUSTMENT
  OTHER
}

/// Finished-goods stock location (warehouse inventory — NOT DeliveryRunStock truck).
enum StockLocationType {
  WAREHOUSE
  PLANT
  STORE
}

/// Warehouse stock ledger. TRANSFER_* when warehouse flag ON (also used for truck load/return).
/// PURCHASE_IN / PRODUCTION_* callers exist; SALE_OUT planned for non-truck POS/Orders.
enum StockMovementType {
  OPENING
  ADJUSTMENT
  TRANSFER_OUT
  TRANSFER_IN
  PURCHASE_IN
  PRODUCTION_IN
  PRODUCTION_CONSUME
  SALE_OUT
}

enum LedgerEntryType {
  DELIVERY_SALE
  PAYMENT
  ADJUSTMENT
  OPENING_BALANCE
  REFUND
  ORDER_SALE
}

enum FileVisibility {
  PUBLIC
  PRIVATE
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

// ─── Tenant ───────────────────────────────────────────────────

model Tenant {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  domain      String?
  subdomain   String?      @unique
  status      TenantStatus @default(PENDING)
  ownerUserId String?
  timezone    String       @default("UTC")
  currency    String       @default("USD")
  logo        String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  members               TenantMember[]
  userSessions          UserSession[]
  userRoles             UserRole[]
  subscriptions         Subscription[]
  settings              TenantSettings?
  features              TenantFeature[]
  files                 File[]
  notifications         Notification[]
  auditLogs             AuditLog[]
  areas                 Area[]
  products              Product[]
  customers             Customer[]
  vehicles              Vehicle[]
  deliveryRuns          DeliveryRun[]
  deliveries            Delivery[]
  deliveryRunStocks     DeliveryRunStock[]
  deliveryItems         DeliveryItem[]
  containerMovements    ContainerMovement[]
  customerLedgerEntries CustomerLedgerEntry[]
  payments              Payment[]
  refillBatches         RefillBatch[]
  deliveryRunRefillLoads DeliveryRunRefillLoad[]
  expenses              Expense[]
  cashHandovers         CashHandover[]
  collectionVisits      CollectionVisit[]
  deliverySchedules     CustomerDeliverySchedule[]
  deliveryScheduleItems CustomerDeliveryScheduleItem[]
  plannedDeliveryStops  PlannedDeliveryStop[]
  plannedDeliveryStopItems PlannedDeliveryStopItem[]
  customerOrders        CustomerOrder[]
  orderItems            OrderItem[]
  orderPayments         OrderPayment[]
  orderStatusEvents     OrderStatusEvent[]
  customerInvoices      CustomerInvoice[]
  customerInvoiceLines  CustomerInvoiceLine[]
  stockLocations        StockLocation[]
  stockBalances         StockBalance[]
  stockMovements        StockMovement[]
  vendors               Vendor[]
  rawMaterials          RawMaterial[]
  rawMaterialBalances   RawMaterialBalance[]
  rawMaterialMovements  RawMaterialMovement[]
  purchaseOrders        PurchaseOrder[]
  purchaseOrderLines    PurchaseOrderLine[]
  goodsReceipts         GoodsReceipt[]
  goodsReceiptLines     GoodsReceiptLine[]
  vendorBills           VendorBill[]
  vendorBillLines       VendorBillLine[]
  vendorBillPayments    VendorBillPayment[]
  vendorLedgerEntries   VendorLedgerEntry[]
  boms                  Bom[]
  bomLines              BomLine[]
  productionOrders      ProductionOrder[]
  productionConsumeLines ProductionConsumeLine[]

  @@index([status])
  @@index([createdAt])
  @@map("tenants")
}

// ─── User ─────────────────────────────────────────────────────
// Global user — one record per email address, shared across all tenants.
// Per-tenant membership and status live in TenantMember.

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  firstName       String
  lastName        String
  phone           String?
  passwordHash    String
  isSuperAdmin    Boolean   @default(false)
  emailVerified   Boolean   @default(false)
  emailVerifiedAt DateTime?
  avatarUrl       String?
  timezone        String?
  totpSecret      String? // null = TOTP not set up
  totpEnabled     Boolean   @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  memberships              TenantMember[]
  sessions                 UserSession[]
  roles                    UserRole[]
  files                    File[]
  notifications            Notification[]
  auditLogs                AuditLog[]
  loginAttempts            LoginAttempt[]
  defaultRiderForCustomers Customer[]
  deliveryRunsAsRider      DeliveryRun[]
  paymentsCollected        Payment[]
  refillBatchesCreated     RefillBatch[]
  expensesAsStaff          Expense[]
  cashHandoversAsRider     CashHandover[] @relation("CashHandoverRider")
  cashHandoversReceived    CashHandover[] @relation("CashHandoverReceiver")
  collectionVisits         CollectionVisit[]
  deliverySchedulesAsRider CustomerDeliverySchedule[]
  ordersCreated            CustomerOrder[]             @relation("OrderCreatedBy")
  ordersCancelled          CustomerOrder[]             @relation("OrderCancelledBy")
  ordersRefunded           CustomerOrder[]             @relation("OrderRefundedBy")
  orderPaymentsCreated     OrderPayment[]
  orderStatusEvents        OrderStatusEvent[]
  invoicesCreated          CustomerInvoice[]           @relation("InvoiceCreatedBy")
  invoicesIssued           CustomerInvoice[]           @relation("InvoiceIssuedBy")
  invoicesVoided           CustomerInvoice[]           @relation("InvoiceVoidedBy")
  stockMovementsCreated    StockMovement[]             @relation("StockMovementCreatedBy")
  rawMaterialMovementsCreated RawMaterialMovement[]    @relation("RawMaterialMovementCreatedBy")
  purchaseOrdersCreated    PurchaseOrder[]             @relation("PurchaseOrderCreatedBy")
  goodsReceiptsReceived    GoodsReceipt[]              @relation("GoodsReceiptReceivedBy")
  vendorBillsCreated       VendorBill[]                @relation("VendorBillCreatedBy")
  vendorBillPaymentsCreated VendorBillPayment[]        @relation("VendorBillPaymentCreatedBy")
  productionOrdersCreated  ProductionOrder[]           @relation("ProductionOrderCreatedBy")

  @@index([email])
  @@map("users")
}

// ─── TenantMember ─────────────────────────────────────────────
// Bridge table — links a global User to a Tenant with per-tenant
// status, invitation metadata, and join date.

model TenantMember {
  id          String       @id @default(cuid())
  userId      String
  tenantId    String
  status      MemberStatus @default(INVITED)
  invitedById String?
  joinedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("tenant_members")
}

// ─── UserSession ──────────────────────────────────────────────

model UserSession {
  id               String   @id @default(cuid())
  userId           String
  tenantId         String? // nullable — SA sessions and reset/verify tokens have no tenant
  refreshTokenHash String   @db.Text
  ipAddress        String?
  userAgent        String?  @db.Text
  expiresAt        DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([userId])
  @@index([tenantId])
  @@index([expiresAt])
  @@map("user_sessions")
}

// ─── Role ─────────────────────────────────────────────────────

model Role {
  id          String  @id @default(cuid())
  tenantId    String?
  name        String
  slug        String
  description String?
  isSystem    Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  permissions RolePermission[]
  userRoles   UserRole[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("roles")
}

// ─── Permission ───────────────────────────────────────────────

model Permission {
  id          String  @id @default(cuid())
  module      String
  action      String
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles RolePermission[]

  @@unique([module, action])
  @@index([module])
  @@map("permissions")
}

// ─── RolePermission ───────────────────────────────────────────

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  createdAt DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// ─── UserRole ─────────────────────────────────────────────────

model UserRole {
  id           String  @id @default(cuid())
  userId       String
  roleId       String
  tenantId     String
  assignedById String?

  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([userId, roleId, tenantId])
  @@index([userId])
  @@index([tenantId])
  @@map("user_roles")
}

// ─── Plan ─────────────────────────────────────────────────────

model Plan {
  id           String       @id @default(cuid())
  name         String
  slug         String       @unique
  description  String?
  price        Decimal      @db.Decimal(10, 2)
  currency     String       @default("USD")
  billingCycle BillingCycle @default(MONTHLY)
  isActive     Boolean      @default(true)
  features     Json?
  maxUsers     Int          @default(5)
  maxStorage   Int          @default(1024)
  trialDays    Int          @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]

  @@index([isActive])
  @@map("plans")
}

// ─── Subscription ─────────────────────────────────────────────

model Subscription {
  id           String             @id @default(cuid())
  tenantId     String
  planId       String
  status       SubscriptionStatus @default(TRIAL)
  startDate    DateTime
  endDate      DateTime?
  trialEndDate DateTime?
  cancelledAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  plan   Plan   @relation(fields: [planId], references: [id])

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("subscriptions")
}

// ─── TenantSettings ───────────────────────────────────────────

model TenantSettings {
  id             String  @id @default(cuid())
  tenantId       String  @unique
  orgName        String?
  logo           String?
  phone          String?
  address        String? @db.Text
  timezone       String  @default("UTC")
  currency       String  @default("USD")
  dateFormat     String  @default("YYYY-MM-DD")
  invoicePrefix  String  @default("INV")
  /// Incremented when an invoice is issued (prefix + seq → invoiceNumber).
  lastInvoiceSeq Int     @default(0)
  themeColor     String  @default("#000000")
  /// Allowed invite email domains, e.g. ["acme.com","partner.org"]. Empty = any domain.
  allowedDomains Json    @default("[]")
  /// Sidebar layout: { "more": ["products","vehicles",...] }. Empty / missing = all items primary.
  sidebarNav     Json    @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("tenant_settings")
}

// ─── Area (tenant served areas — not JSON on settings) ────────

model Area {
  id        String    @id @default(cuid())
  tenantId  String
  name      String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  customers Customer[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("areas")
}

// ─── Product (flat — each water size is its own product) ───────

model Product {
  id                  String          @id @default(cuid())
  tenantId            String
  name                String
  volume              Decimal?        @db.Decimal(10, 2)
  /// Legacy free-text display unit (kept for old UI); prefer baseUnit.
  unit                String?
  sku                 String?
  isActive            Boolean         @default(true)
  isReturnable        Boolean         @default(true)
  containerType       String?
  /// Price per baseUnit (PCS / LTR / KG).
  defaultSellingPrice Decimal         @db.Decimal(10, 2)
  baseUnit            ProductBaseUnit @default(PCS)
  /// e.g. 12 bottles per CTN — conversion helper only; sale stores base units.
  unitsPerPack        Int?
  packLabel           String?
  /// Packaging size only (e.g. 20 for a 20L returnable can) — NOT sale qty.
  containerCapacity   Decimal?        @db.Decimal(10, 2)
  /// When false, quantityDelivered / filledCount must be whole numbers.
  allowFractionalQty  Boolean         @default(false)
  /// Optional low-stock threshold (base units). Used when inventory flag is ON.
  reorderLevel        Decimal?        @db.Decimal(12, 3)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  deletedAt           DateTime?

  tenant             Tenant                 @relation(fields: [tenantId], references: [id])
  costHistory        ProductCostHistory[]
  customerPrices     CustomerProductPrice[]
  deliveryRunStocks  DeliveryRunStock[]
  deliveryItems      DeliveryItem[]
  containerMovements ContainerMovement[]
  refillBatches      RefillBatch[]
  refillLoads        DeliveryRunRefillLoad[]
  scheduleItems      CustomerDeliveryScheduleItem[]
  plannedStopItems   PlannedDeliveryStopItem[]
  orderItems         OrderItem[]
  stockBalances      StockBalance[]
  stockMovements     StockMovement[]
  purchaseOrderLines PurchaseOrderLine[]
  boms               Bom[]
  productionOrders   ProductionOrder[]

  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("products")
}

model ProductCostHistory {
  id            String   @id @default(cuid())
  tenantId      String
  productId     String
  costPerUnit   Decimal  @db.Decimal(10, 2)
  effectiveFrom DateTime
  notes         String?
  createdById   String?
  createdAt     DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])

  @@index([tenantId, productId])
  @@index([tenantId, productId, effectiveFrom])
  @@map("product_cost_history")
}

// ─── Customer ─────────────────────────────────────────────────

model Customer {
  id                       String         @id @default(cuid())
  tenantId                 String
  name                     String
  email                    String?
  phone                    String
  secondaryPhone           String?
  address                  String         @db.Text
  areaId                   String
  locationNotes            String?        @db.Text
  status                   CustomerStatus @default(ACTIVE)
  paymentCycle             PaymentCycle   @default(CASH_ON_DELIVERY)
  billingDueDate           Int?
  billingAnchorDate        DateTime?
  openingReceivableBalance Decimal        @default(0) @db.Decimal(10, 2)
  containerDeposit         Decimal        @default(0) @db.Decimal(10, 2)
  defaultRiderId           String?
  /// Rider-captured promise; overrides cycle due for dashboard until paid/cleared/cancelled
  promisedDueDate          DateTime?
  promisedDueAmount        Decimal?       @db.Decimal(10, 2)
  promisedDueDeliveryId    String?
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt
  deletedAt                DateTime?

  tenant              Tenant                 @relation(fields: [tenantId], references: [id])
  area                Area                   @relation(fields: [areaId], references: [id])
  defaultRider        User?                  @relation(fields: [defaultRiderId], references: [id])
  promisedDueDelivery Delivery?              @relation("PromisedDueSource", fields: [promisedDueDeliveryId], references: [id], onDelete: SetNull)
  productPrices       CustomerProductPrice[]
  deliveries          Delivery[]
  containerMovements  ContainerMovement[]
  ledgerEntries       CustomerLedgerEntry[]
  payments            Payment[]
  collectionVisits    CollectionVisit[]
  deliverySchedule    CustomerDeliverySchedule?
  plannedStops        PlannedDeliveryStop[]
  orders              CustomerOrder[]
  invoices            CustomerInvoice[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, areaId])
  @@index([tenantId, promisedDueDate])
  @@map("customers")
}

model CustomerProductPrice {
  id           String   @id @default(cuid())
  tenantId     String
  customerId   String
  productId    String
  pricePerUnit Decimal  @db.Decimal(10, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])

  @@unique([customerId, productId])
  @@index([tenantId, customerId])
  @@map("customer_product_prices")
}

// ─── Vehicle (loaders / delivery vehicles) ────────────────────

model Vehicle {
  id          String        @id @default(cuid())
  tenantId    String
  name        String
  plateNumber String?
  type        String?
  status      VehicleStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  tenant            Tenant              @relation(fields: [tenantId], references: [id])
  deliveryRuns      DeliveryRun[]
  ContainerMovement ContainerMovement[]
  expenses          Expense[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("vehicles")
}

// ─── Delivery Domain ─────────────────────────────────────────

model DeliveryRun {
  id                 String    @id @default(cuid())
  tenantId           String
  riderId            String
  vehicleId          String
  date               DateTime
  openingCash        Decimal   @default(0) @db.Decimal(10, 2)
  status             RunStatus @default(OPEN)
  closingCash        Decimal?  @db.Decimal(10, 2)
  totalSales         Decimal   @default(0) @db.Decimal(10, 2)
  totalCashCollected Decimal   @default(0) @db.Decimal(10, 2)
  totalExpenses      Decimal   @default(0) @db.Decimal(10, 2)
  notes              String?
  /// Warehouse location stock was loaded from (inventory ON). Null when inventory OFF / legacy.
  loadLocationId     String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  tenant       Tenant             @relation(fields: [tenantId], references: [id])
  rider        User               @relation(fields: [riderId], references: [id])
  vehicle      Vehicle            @relation(fields: [vehicleId], references: [id])
  loadLocation StockLocation?     @relation("DeliveryRunLoadLocation", fields: [loadLocationId], references: [id], onDelete: SetNull)
  stocks       DeliveryRunStock[]
  deliveries   Delivery[]
  refillLoads  DeliveryRunRefillLoad[]
  expenses     Expense[]
  cashHandovers CashHandover[]
  plannedStops PlannedDeliveryStop[]

  @@index([tenantId])
  @@index([tenantId, riderId])
  @@index([tenantId, date])
  @@index([tenantId, status])
  @@index([tenantId, loadLocationId])
  @@map("delivery_runs")
}

model DeliveryRunStock {
  id            String    @id @default(cuid())
  tenantId      String
  deliveryRunId String
  productId     String
  stockType     StockType
  /// Units loaded in product baseUnit (cans / litres / kg).
  filledCount   Decimal   @default(0) @db.Decimal(12, 3)
  /// Whole filled packaging units on vehicle (cans). For PCS equals filledCount; for LTR/KG set explicitly (e.g. 40L in 3 cans → 3).
  filledPackagingCount Int @default(0)
  /// Whole packaging empties on vehicle (always integer packaging units).
  emptyCount    Int       @default(0)

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  deliveryRun DeliveryRun @relation(fields: [deliveryRunId], references: [id])
  product     Product     @relation(fields: [productId], references: [id])

  @@unique([deliveryRunId, productId, stockType])
  @@index([tenantId])
  @@index([productId])
  @@map("delivery_run_stocks")
}

model Delivery {
  id               String         @id @default(cuid())
  tenantId         String
  deliveryRunId    String
  customerId       String
  deliveryDate     DateTime
  cashReceived     Decimal        @default(0) @db.Decimal(10, 2)
  paymentMethod    PaymentMethod  @default(CASH)
  status           DeliveryStatus @default(DELIVERED)
  notes            String?
  /// Optional: customer promised to pay on this date (does NOT create ledger/payment)
  promisedPayDate  DateTime?
  promisedAmount   Decimal?       @db.Decimal(10, 2)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  tenant                   Tenant     @relation(fields: [tenantId], references: [id])
  deliveryRun              DeliveryRun @relation(fields: [deliveryRunId], references: [id])
  customer                 Customer   @relation(fields: [customerId], references: [id])
  items                    DeliveryItem[]
  customersWithThisPromise Customer[] @relation("PromisedDueSource")
  completedPlannedStop     PlannedDeliveryStop?

  @@index([tenantId])
  @@index([tenantId, deliveryRunId])
  @@index([tenantId, customerId])
  @@index([tenantId, deliveryDate])
  @@map("deliveries")
}

model DeliveryItem {
  id                   String   @id @default(cuid())
  tenantId             String
  deliveryId           String
  productId            String
  /// Always in product baseUnit (PCS / LTR / KG).
  quantityDelivered    Decimal  @db.Decimal(12, 3)
  /// Whole packaging units given to customer (cans). For PCS usually = quantity; for LTR/KG set explicitly.
  containersDelivered  Int      @default(0)
  /// Whole packaging units returned (cans/crates) — not litres/kg.
  emptiesReceived      Int      @default(0)
  sellingPriceSnapshot Decimal  @db.Decimal(10, 2)
  unitCostSnapshot     Decimal  @db.Decimal(10, 2)
  lineTotal            Decimal  @db.Decimal(12, 2)
  createdAt            DateTime @default(now())

  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  delivery           Delivery            @relation(fields: [deliveryId], references: [id])
  product            Product             @relation(fields: [productId], references: [id])
  containerMovements ContainerMovement[]

  @@index([tenantId])
  @@index([tenantId, deliveryId])
  @@index([tenantId, productId])
  @@map("delivery_items")
}

model ContainerMovement {
  id             String                @id @default(cuid())
  tenantId       String
  productId      String
  deliveryItemId String?
  customerId     String?
  vehicleId      String?
  movementType   ContainerMovementType
  quantity       Int
  notes          String?
  createdAt      DateTime              @default(now())

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  product      Product       @relation(fields: [productId], references: [id])
  deliveryItem DeliveryItem? @relation(fields: [deliveryItemId], references: [id])
  customer     Customer?     @relation(fields: [customerId], references: [id])
  vehicle      Vehicle?      @relation(fields: [vehicleId], references: [id])

  @@index([tenantId, productId])
  @@index([tenantId, customerId, productId])
  @@index([tenantId, movementType])
  @@map("container_movements")
}

model CustomerLedgerEntry {
  id            String          @id @default(cuid())
  tenantId      String
  customerId    String
  entryType     LedgerEntryType
  amount        Decimal         @db.Decimal(10, 2)
  referenceId   String?
  referenceType String?
  notes         String?
  createdAt     DateTime        @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  @@index([tenantId, customerId])
  @@index([tenantId, customerId, createdAt])
  @@map("customer_ledger_entries")
}

// ─── Payment (standalone customer payments) ───────────────────
// Customer receivable balance = SUM(CustomerLedgerEntry.amount). Never store an editable balance.

model Payment {
  id            String        @id @default(cuid())
  tenantId      String
  customerId    String
  amount        Decimal       @db.Decimal(10, 2)
  paymentDate   DateTime
  method        PaymentMethod
  collectedById String?
  reference     String?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  customer         Customer          @relation(fields: [customerId], references: [id])
  collectedBy      User?             @relation(fields: [collectedById], references: [id])
  collectionVisits CollectionVisit[]

  @@index([tenantId])
  @@index([tenantId, customerId])
  @@index([tenantId, paymentDate])
  @@map("payments")
}

// ─── Collection visit (field collection workflow) ─────────────

model CollectionVisit {
  id              String                  @id @default(cuid())
  tenantId        String
  customerId      String
  collectorId     String
  visitDate       DateTime
  outcome         CollectionVisitOutcome
  amountCollected Decimal?                @db.Decimal(10, 2)
  paymentId       String?
  followUpDate    DateTime?
  notes           String?                 @db.Text
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  customer  Customer @relation(fields: [customerId], references: [id])
  collector User     @relation(fields: [collectorId], references: [id])
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([tenantId, visitDate])
  @@index([tenantId, collectorId])
  @@index([tenantId, followUpDate])
  @@index([tenantId, customerId])
  @@map("collection_visits")
}

// ─── Delivery schedules (interval-based recurring) ────────────

model CustomerDeliverySchedule {
  id             String    @id @default(cuid())
  tenantId       String
  customerId     String    @unique
  /// 1 = every day; 2 = skip one day ("ek din chor"); 16 = skip 15 days.
  intervalDays   Int
  isActive       Boolean   @default(true)
  startDate      DateTime?
  defaultRiderId String?
  notes          String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant       Tenant                          @relation(fields: [tenantId], references: [id])
  customer     Customer                        @relation(fields: [customerId], references: [id])
  defaultRider User?                           @relation(fields: [defaultRiderId], references: [id])
  items        CustomerDeliveryScheduleItem[]
  plannedStops PlannedDeliveryStop[]

  @@unique([tenantId, customerId])
  @@index([tenantId, isActive])
  @@map("customer_delivery_schedules")
}

model CustomerDeliveryScheduleItem {
  id               String  @id @default(cuid())
  tenantId         String
  scheduleId       String
  productId        String
  /// Always in product baseUnit (PCS / LTR / KG) — never cartons.
  defaultQuantity  Decimal @db.Decimal(12, 3)

  tenant   Tenant                    @relation(fields: [tenantId], references: [id])
  schedule CustomerDeliverySchedule  @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  product  Product                   @relation(fields: [productId], references: [id])

  @@unique([scheduleId, productId])
  @@index([tenantId])
  @@map("customer_delivery_schedule_items")
}

model PlannedDeliveryStop {
  id            String             @id @default(cuid())
  tenantId      String
  planDate      DateTime
  customerId    String
  scheduleId    String?
  deliveryRunId String?
  deliveryId    String?            @unique
  status        PlannedStopStatus  @default(PLANNED)
  source        PlannedStopSource  @default(SCHEDULE)
  skipReason    String?
  failReason    String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  tenant      Tenant                     @relation(fields: [tenantId], references: [id])
  customer    Customer                   @relation(fields: [customerId], references: [id])
  schedule    CustomerDeliverySchedule?  @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  deliveryRun DeliveryRun?               @relation(fields: [deliveryRunId], references: [id], onDelete: SetNull)
  /// Linked when COMPLETED.
  completedDelivery Delivery?            @relation(fields: [deliveryId], references: [id], onDelete: SetNull)
  items       PlannedDeliveryStopItem[]

  @@index([tenantId, planDate, status])
  @@index([tenantId, customerId, planDate])
  @@index([tenantId, deliveryRunId])
  @@index([tenantId, scheduleId, status])
  @@map("planned_delivery_stops")
}

model PlannedDeliveryStopItem {
  id               String  @id @default(cuid())
  tenantId         String
  plannedStopId    String
  productId        String
  /// Base units (from schedule default or rider edit).
  plannedQuantity  Decimal @db.Decimal(12, 3)

  tenant      Tenant              @relation(fields: [tenantId], references: [id])
  plannedStop PlannedDeliveryStop @relation(fields: [plannedStopId], references: [id], onDelete: Cascade)
  product     Product             @relation(fields: [productId], references: [id])

  @@unique([plannedStopId, productId])
  @@index([tenantId])
  @@map("planned_delivery_stop_items")
}

// ─── Refill Batch (plant fill log — per product) ──────────────
// Does NOT write ProductCostHistory. Delivery COGS stays on cost history.

model RefillBatch {
  id              String   @id @default(cuid())
  tenantId        String
  productId       String
  date            DateTime
  cansFilledCount Int
  costPerUnit     Decimal  @db.Decimal(10, 2)
  totalCost       Decimal  @db.Decimal(10, 2)
  notes           String?
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant      Tenant                 @relation(fields: [tenantId], references: [id])
  product     Product                @relation(fields: [productId], references: [id])
  createdBy   User?                  @relation(fields: [createdById], references: [id])
  loads       DeliveryRunRefillLoad[]

  @@index([tenantId])
  @@index([tenantId, productId])
  @@index([tenantId, date])
  @@map("refill_batches")
}

model DeliveryRunRefillLoad {
  id              String @id @default(cuid())
  tenantId        String
  deliveryRunId   String
  refillBatchId   String
  productId       String
  quantityLoaded  Int

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  deliveryRun DeliveryRun @relation(fields: [deliveryRunId], references: [id])
  refillBatch RefillBatch @relation(fields: [refillBatchId], references: [id])
  product     Product     @relation(fields: [productId], references: [id])

  @@unique([deliveryRunId, refillBatchId])
  @@index([tenantId, refillBatchId])
  @@index([tenantId, deliveryRunId])
  @@map("delivery_run_refill_loads")
}

// ─── Expense (flexible title — no category enum) ──────────────

model Expense {
  id            String        @id @default(cuid())
  tenantId      String
  title         String
  description   String?       @db.Text
  date          DateTime
  amount        Decimal       @db.Decimal(10, 2)
  vehicleId     String?
  deliveryRunId String?
  staffId       String?
  paymentMethod PaymentMethod @default(CASH)
  reference     String?
  isPaidByRider Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  vehicle     Vehicle?     @relation(fields: [vehicleId], references: [id])
  deliveryRun DeliveryRun? @relation(fields: [deliveryRunId], references: [id])
  staff       User?        @relation(fields: [staffId], references: [id])

  @@index([tenantId])
  @@index([tenantId, date])
  @@map("expenses")
}

// ─── Cash Handover (rider → office) ───────────────────────────

model CashHandover {
  id            String   @id @default(cuid())
  tenantId      String
  riderId       String
  receivedById  String
  amount        Decimal  @db.Decimal(10, 2)
  handoverDate  DateTime
  reference     String?
  notes         String?
  deliveryRunId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  rider       User         @relation("CashHandoverRider", fields: [riderId], references: [id])
  receivedBy  User         @relation("CashHandoverReceiver", fields: [receivedById], references: [id])
  deliveryRun DeliveryRun? @relation(fields: [deliveryRunId], references: [id])

  @@index([tenantId])
  @@index([tenantId, riderId])
  @@index([tenantId, handoverDate])
  @@map("cash_handovers")
}

// ─── PlatformSettings (singleton — Super Admin platform prefs) ─

model PlatformSettings {
  id              String @id @default("platform")
  appName         String @default("SaaS Boilerplate")
  supportEmail    String @default("support@example.com")
  defaultTimezone String @default("UTC")
  defaultCurrency String @default("USD")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("platform_settings")
}

// ─── FeatureFlag ──────────────────────────────────────────────

model FeatureFlag {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  isGlobal    Boolean @default(false)
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenantFeatures TenantFeature[]

  @@index([isActive])
  @@map("feature_flags")
}

// ─── TenantFeature ────────────────────────────────────────────

model TenantFeature {
  id            String  @id @default(cuid())
  tenantId      String
  featureFlagId String
  isEnabled     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  featureFlag FeatureFlag @relation(fields: [featureFlagId], references: [id])

  @@unique([tenantId, featureFlagId])
  @@index([tenantId])
  @@map("tenant_features")
}

// ─── File ─────────────────────────────────────────────────────

model File {
  id           String         @id @default(cuid())
  tenantId     String
  uploadedById String
  originalName String
  storedName   String
  mimeType     String
  size         Int
  path         String         @db.Text
  visibility   FileVisibility @default(PRIVATE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant     Tenant @relation(fields: [tenantId], references: [id])
  uploadedBy User   @relation(fields: [uploadedById], references: [id])

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@map("files")
}

// ─── Notification ─────────────────────────────────────────────

model Notification {
  id       String           @id @default(cuid())
  tenantId String
  userId   String
  title    String
  body     String           @db.Text
  type     NotificationType @default(INFO)
  isRead   Boolean          @default(false)
  readAt   DateTime?
  link     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@index([tenantId, isRead])
  @@index([tenantId, createdAt])
  @@map("notifications")
}

// ─── AuditLog ─────────────────────────────────────────────────

model AuditLog {
  id        String  @id @default(cuid())
  tenantId  String?
  userId    String?
  action    String
  module    String
  entityId  String?
  oldValue  Json?
  newValue  Json?
  ipAddress String?
  userAgent String? @db.Text

  createdAt DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id])
  user   User?   @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([tenantId, module])
  @@index([tenantId, userId])
  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

// ─── LoginAttempt ─────────────────────────────────────────────

model LoginAttempt {
  id        String  @id @default(cuid())
  userId    String?
  email     String
  ipAddress String?
  success   Boolean @default(false)

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([email])
  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
  @@map("login_attempts")
}

// ─── Customer Orders (standalone channel — not DeliveryRun) ───
// No FKs to Delivery / DeliveryRun / PlannedDeliveryStop.
// Warehouse SALE_OUT on place when inventory ON (non-truck). Skip if future DeliveryRun link.

model CustomerOrder {
  id                String             @id @default(cuid())
  tenantId          String
  customerId        String
  status            OrderStatus        @default(DRAFT)
  paymentStatus     OrderPaymentStatus @default(UNPAID)
  orderNumber       Int
  subtotal          Decimal            @db.Decimal(10, 2)
  discountTotal     Decimal            @default(0) @db.Decimal(10, 2)
  deliveryCharges   Decimal            @default(0) @db.Decimal(10, 2)
  total             Decimal            @db.Decimal(10, 2)
  amountPaid        Decimal            @default(0) @db.Decimal(10, 2)
  amountDue         Decimal            @db.Decimal(10, 2)
  shippingAddress   String?            @db.Text
  shippingNotes     String?            @db.Text
  internalNotes     String?            @db.Text
  preferredShipDate DateTime?          @db.Date
  cancelReason      String?
  cancelledAt       DateTime?
  cancelledById     String?
  refundReason      String?
  refundedAt        DateTime?
  refundedById      String?
  refundAmount      Decimal?           @db.Decimal(10, 2)
  createdById       String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?

  tenant      Tenant             @relation(fields: [tenantId], references: [id])
  customer    Customer           @relation(fields: [customerId], references: [id])
  createdBy   User               @relation("OrderCreatedBy", fields: [createdById], references: [id])
  cancelledBy User?              @relation("OrderCancelledBy", fields: [cancelledById], references: [id])
  refundedBy  User?              @relation("OrderRefundedBy", fields: [refundedById], references: [id])
  items       OrderItem[]
  payments    OrderPayment[]
  statusEvents OrderStatusEvent[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId, status])
  @@index([tenantId, paymentStatus])
  @@index([tenantId, customerId])
  @@index([tenantId, createdAt])
  @@map("customer_orders")
}

model OrderItem {
  id                 String   @id @default(cuid())
  tenantId           String
  orderId            String
  productId          String
  quantity           Decimal  @db.Decimal(12, 3)
  quantityDelivered  Decimal  @default(0) @db.Decimal(12, 3)
  /// Whole packaging units planned / given (cans). Accumulated on deliver when containers flag ON.
  containersDelivered Int     @default(0)
  /// Whole empties received from customer. Accumulated on deliver when containers flag ON.
  emptiesReceived    Int      @default(0)
  unitPriceSnapshot  Decimal  @db.Decimal(10, 2)
  costSnapshot       Decimal? @db.Decimal(10, 2)
  lineDiscount       Decimal  @default(0) @db.Decimal(10, 2)
  lineTotal          Decimal  @db.Decimal(10, 2)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant  Tenant        @relation(fields: [tenantId], references: [id])
  order   CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product       @relation(fields: [productId], references: [id])

  @@index([tenantId, orderId])
  @@index([tenantId, productId])
  @@map("order_items")
}

model OrderPayment {
  id          String        @id @default(cuid())
  tenantId    String
  orderId     String
  paymentId   String?
  method      PaymentMethod
  amount      Decimal       @db.Decimal(10, 2)
  paidAt      DateTime
  createdById String?
  createdAt   DateTime      @default(now())

  tenant    Tenant        @relation(fields: [tenantId], references: [id])
  order     CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdBy User?         @relation(fields: [createdById], references: [id])

  @@index([tenantId, orderId])
  @@map("order_payments")
}

model OrderStatusEvent {
  id         String       @id @default(cuid())
  tenantId   String
  orderId    String
  fromStatus OrderStatus?
  toStatus   OrderStatus
  at         DateTime     @default(now())
  byId       String?
  note       String?

  tenant Tenant        @relation(fields: [tenantId], references: [id])
  order  CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  by     User?         @relation(fields: [byId], references: [id])

  @@index([tenantId, orderId])
  @@index([tenantId, orderId, at])
  @@map("order_status_events")
}

// ─── Customer Invoices (period statements — document only) ────
// Issue / void NEVER post ledger. Soft refs via referenceType/referenceId.

model CustomerInvoice {
  id               String            @id @default(cuid())
  tenantId         String
  customerId       String
  /// Null while DRAFT; set on Issue as invoicePrefix + padded seq.
  invoiceNumber    String?
  periodStart      DateTime          @db.Date
  periodEnd        DateTime          @db.Date
  periodType       InvoicePeriodType
  status           InvoiceStatus     @default(DRAFT)
  currency         String
  openingBalance   Decimal           @db.Decimal(10, 2)
  salesTotal       Decimal           @db.Decimal(10, 2)
  deliveriesTotal  Decimal           @db.Decimal(10, 2)
  ordersTotal      Decimal           @db.Decimal(10, 2)
  paymentsTotal    Decimal           @db.Decimal(10, 2)
  adjustmentsTotal Decimal           @default(0) @db.Decimal(10, 2)
  closingBalance   Decimal           @db.Decimal(10, 2)
  issuedAt         DateTime?
  issuedById       String?
  voidedAt         DateTime?
  voidedById       String?
  voidReason       String?
  notes            String?           @db.Text
  createdById      String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  tenant    Tenant               @relation(fields: [tenantId], references: [id])
  customer  Customer             @relation(fields: [customerId], references: [id])
  createdBy User                 @relation("InvoiceCreatedBy", fields: [createdById], references: [id])
  issuedBy  User?                @relation("InvoiceIssuedBy", fields: [issuedById], references: [id])
  voidedBy  User?                @relation("InvoiceVoidedBy", fields: [voidedById], references: [id])
  lines     CustomerInvoiceLine[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, customerId])
  @@index([tenantId, status])
  @@index([tenantId, periodStart, periodEnd])
  @@map("customer_invoices")
}

model CustomerInvoiceLine {
  id            String          @id @default(cuid())
  tenantId      String
  invoiceId     String
  lineType      InvoiceLineType
  productId     String?
  description   String
  quantity      Decimal?        @db.Decimal(12, 3)
  unitPrice     Decimal?        @db.Decimal(10, 2)
  amount        Decimal         @db.Decimal(10, 2)
  referenceType String?
  referenceId   String?
  occurredAt    DateTime?
  sortOrder     Int             @default(0)

  tenant  Tenant          @relation(fields: [tenantId], references: [id])
  invoice CustomerInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId, invoiceId])
  @@index([tenantId, lineType])
  @@map("customer_invoice_lines")
}

// ─── Warehouse inventory (finished goods) ─────────────────────
// Separate from DeliveryRunStock (truck OPENING/CLOSING). Never couple the two.
// Multi-location + TRANSFER_* gated by feature flag `warehouse` (needs `inventory`).

model StockLocation {
  id        String            @id @default(cuid())
  tenantId  String
  name      String
  type      StockLocationType @default(WAREHOUSE)
  code      String?
  notes     String?
  isActive  Boolean           @default(true)
  isDefault Boolean           @default(false)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  tenant    Tenant          @relation(fields: [tenantId], references: [id])
  balances  StockBalance[]
  movements StockMovement[]
  rawBalances  RawMaterialBalance[]
  rawMovements RawMaterialMovement[]
  goodsReceipts GoodsReceipt[]
  productionOrders ProductionOrder[]
  deliveryRunsLoaded DeliveryRun[] @relation("DeliveryRunLoadLocation")

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("stock_locations")
}

model StockBalance {
  id         String  @id @default(cuid())
  tenantId   String
  locationId String
  productId  String
  /// Base units — same idea as Product.baseUnit. Never free-edit; post StockMovement.
  quantity   Decimal @db.Decimal(12, 3)
  updatedAt  DateTime @updatedAt

  tenant   Tenant        @relation(fields: [tenantId], references: [id])
  location StockLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  product  Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([tenantId, locationId, productId])
  @@index([tenantId])
  @@index([tenantId, productId])
  @@map("stock_balances")
}

model StockMovement {
  id              String            @id @default(cuid())
  tenantId        String
  locationId      String
  productId       String
  type            StockMovementType
  /// Signed qty: +IN / −OUT for this location.
  quantity        Decimal           @db.Decimal(12, 3)
  reason          String?
  referenceType   String?
  referenceId     String?
  /// Links TRANSFER_OUT + TRANSFER_IN pair.
  transferGroupId String?
  createdByUserId String?
  createdAt       DateTime          @default(now())

  tenant    Tenant        @relation(fields: [tenantId], references: [id])
  location  StockLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  product   Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdBy User?         @relation("StockMovementCreatedBy", fields: [createdByUserId], references: [id])

  @@index([tenantId, productId, createdAt])
  @@index([tenantId, locationId])
  @@index([tenantId, transferGroupId])
  @@map("stock_movements")
}

// ─── Vendors (supplier master) ────────────────────────────────
// Soft-deactivate only. Open payables stub until vendor bills ship.

model Vendor {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  phone     String?
  address   String?  @db.Text
  notes     String?  @db.Text
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  purchaseOrders PurchaseOrder[]
  bills          VendorBill[]
  billPayments   VendorBillPayment[]
  ledgerEntries  VendorLedgerEntry[]

  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([tenantId, name])
  @@map("vendors")
}

// ─── Raw materials (separate from finished Products) ──────────
// Stock by StockLocation (reuse inventory locations). Never touch DeliveryRunStock.
// PRODUCTION_CONSUME enum ready; callers ship with production module.

enum RawMaterialUnit {
  KG
  LTR
  PCS
}

enum RawMaterialMovementType {
  OPENING
  ADJUSTMENT
  PURCHASE_IN
  PRODUCTION_CONSUME
}

model RawMaterial {
  id           String          @id @default(cuid())
  tenantId     String
  name         String
  unit         RawMaterialUnit
  sku          String?
  defaultCost  Decimal?        @db.Decimal(12, 2)
  reorderLevel Decimal?        @db.Decimal(12, 3)
  notes        String?         @db.Text
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  tenant    Tenant                @relation(fields: [tenantId], references: [id])
  balances  RawMaterialBalance[]
  movements RawMaterialMovement[]
  costHistory RawMaterialCostHistory[]
  purchaseOrderLines PurchaseOrderLine[]
  bomLines  BomLine[]
  productionConsumeLines ProductionConsumeLine[]

  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([tenantId, name])
  @@map("raw_materials")
}

model RawMaterialCostHistory {
  id            String   @id @default(cuid())
  tenantId      String
  rawMaterialId String
  costPerUnit   Decimal  @db.Decimal(12, 2)
  effectiveFrom DateTime
  notes         String?
  createdById   String?
  createdAt     DateTime @default(now())

  rawMaterial RawMaterial @relation(fields: [rawMaterialId], references: [id], onDelete: Restrict)

  @@index([tenantId, rawMaterialId], map: "rm_cost_hist_tenant_rm_idx")
  @@index([tenantId, rawMaterialId, effectiveFrom], map: "rm_cost_hist_tenant_rm_eff_idx")
  @@map("raw_material_cost_history")
}

model RawMaterialBalance {
  id             String  @id @default(cuid())
  tenantId       String
  locationId     String
  rawMaterialId  String
  /// Never free-edit; post RawMaterialMovement only.
  quantity       Decimal @db.Decimal(12, 3)
  updatedAt      DateTime @updatedAt

  tenant      Tenant        @relation(fields: [tenantId], references: [id])
  location    StockLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  rawMaterial RawMaterial   @relation(fields: [rawMaterialId], references: [id], onDelete: Restrict)

  @@unique([tenantId, locationId, rawMaterialId])
  @@index([tenantId])
  @@index([tenantId, rawMaterialId])
  @@map("raw_material_balances")
}

model RawMaterialMovement {
  id              String                   @id @default(cuid())
  tenantId        String
  locationId      String
  rawMaterialId   String
  type            RawMaterialMovementType
  /// Signed qty: +IN / −OUT for this location.
  quantity        Decimal                  @db.Decimal(12, 3)
  reason          String?
  referenceType   String?
  referenceId     String?
  createdByUserId String?
  createdAt       DateTime                 @default(now())

  tenant      Tenant        @relation(fields: [tenantId], references: [id])
  location    StockLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  rawMaterial RawMaterial   @relation(fields: [rawMaterialId], references: [id], onDelete: Restrict)
  createdBy   User?         @relation("RawMaterialMovementCreatedBy", fields: [createdByUserId], references: [id])

  @@index([tenantId, rawMaterialId, createdAt])
  @@index([tenantId, locationId])
  @@map("raw_material_movements")
}

// ─── Purchase orders + GRN ────────────────────────────────────
// Stock IN only on goods receipt (Step 5). No DeliveryRunStock coupling.

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id              String              @id @default(cuid())
  tenantId        String
  vendorId        String
  status          PurchaseOrderStatus @default(DRAFT)
  poNumber        String?
  expectedDate    DateTime?
  notes           String?             @db.Text
  cancelReason    String?
  createdByUserId String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  tenant    Tenant              @relation(fields: [tenantId], references: [id])
  vendor    Vendor              @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  createdBy User?               @relation("PurchaseOrderCreatedBy", fields: [createdByUserId], references: [id])
  lines     PurchaseOrderLine[]
  receipts  GoodsReceipt[]
  bills     VendorBill[]

  @@unique([tenantId, poNumber])
  @@index([tenantId, status])
  @@index([tenantId, vendorId])
  @@index([tenantId, createdAt])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id              String   @id @default(cuid())
  tenantId        String
  purchaseOrderId String
  lineNo          Int
  /// Exactly one of rawMaterialId / productId (enforced in service).
  rawMaterialId   String?
  productId       String?
  qtyOrdered      Decimal  @db.Decimal(12, 3)
  unitCost        Decimal  @db.Decimal(12, 2)
  qtyReceived     Decimal  @default(0) @db.Decimal(12, 3)

  tenant        Tenant             @relation(fields: [tenantId], references: [id])
  purchaseOrder PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  rawMaterial   RawMaterial?       @relation(fields: [rawMaterialId], references: [id], onDelete: Restrict)
  product       Product?           @relation(fields: [productId], references: [id], onDelete: Restrict)
  receiptLines  GoodsReceiptLine[]

  @@unique([purchaseOrderId, lineNo])
  @@index([tenantId])
  @@index([tenantId, purchaseOrderId])
  @@map("purchase_order_lines")
}

model GoodsReceipt {
  id               String   @id @default(cuid())
  tenantId         String
  purchaseOrderId  String
  locationId       String
  receiptDate      DateTime
  notes            String?  @db.Text
  receivedByUserId String
  createdAt        DateTime @default(now())

  tenant        Tenant             @relation(fields: [tenantId], references: [id])
  purchaseOrder PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  location      StockLocation      @relation(fields: [locationId], references: [id], onDelete: Restrict)
  receivedBy    User               @relation("GoodsReceiptReceivedBy", fields: [receivedByUserId], references: [id])
  lines         GoodsReceiptLine[]
  bills         VendorBill[]

  @@index([tenantId, purchaseOrderId])
  @@index([tenantId, createdAt])
  @@map("goods_receipts")
}

model GoodsReceiptLine {
  id                  String  @id @default(cuid())
  tenantId            String
  goodsReceiptId      String
  purchaseOrderLineId String
  qtyReceived         Decimal @db.Decimal(12, 3)

  tenant            Tenant            @relation(fields: [tenantId], references: [id])
  goodsReceipt      GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderLine PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, goodsReceiptId])
  @@map("goods_receipt_lines")
}

// ─── Vendor bills & payables ──────────────────────────────────
// Separate from customer ledger. Bill = debit (payable↑), payment = credit (payable↓).
// openPayables = sum(totalAmount - paidAmount) for UNPAID|PARTIALLY_PAID.

enum VendorBillStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  VOID
}

enum VendorLedgerEntryType {
  BILL
  PAYMENT
  VOID
}

model VendorBill {
  id               String          @id @default(cuid())
  tenantId         String
  vendorId         String
  purchaseOrderId  String?
  goodsReceiptId   String?
  billNumber       String?
  billDate         DateTime
  dueDate          DateTime?
  notes            String?         @db.Text
  status           VendorBillStatus @default(UNPAID)
  totalAmount      Decimal         @db.Decimal(12, 2)
  paidAmount       Decimal         @default(0) @db.Decimal(12, 2)
  voidReason       String?
  createdByUserId  String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  tenant        Tenant              @relation(fields: [tenantId], references: [id])
  vendor        Vendor              @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  purchaseOrder PurchaseOrder?      @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  goodsReceipt  GoodsReceipt?       @relation(fields: [goodsReceiptId], references: [id], onDelete: SetNull)
  createdBy     User?               @relation("VendorBillCreatedBy", fields: [createdByUserId], references: [id])
  lines         VendorBillLine[]
  payments      VendorBillPayment[]

  @@unique([tenantId, billNumber])
  @@index([tenantId, vendorId])
  @@index([tenantId, status])
  @@index([tenantId, billDate])
  @@map("vendor_bills")
}

model VendorBillLine {
  id                  String  @id @default(cuid())
  tenantId            String
  vendorBillId        String
  lineNo              Int
  description         String
  qty                 Decimal @db.Decimal(12, 3)
  unitCost            Decimal @db.Decimal(12, 2)
  amount              Decimal @db.Decimal(12, 2)
  purchaseOrderLineId String?
  goodsReceiptLineId  String?

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  vendorBill VendorBill @relation(fields: [vendorBillId], references: [id], onDelete: Cascade)

  @@unique([vendorBillId, lineNo])
  @@index([tenantId])
  @@map("vendor_bill_lines")
}

model VendorBillPayment {
  id              String        @id @default(cuid())
  tenantId        String
  vendorBillId    String
  vendorId        String
  amount          Decimal       @db.Decimal(12, 2)
  paymentDate     DateTime
  method          PaymentMethod
  reference       String?
  notes           String?
  createdByUserId String?
  createdAt       DateTime      @default(now())

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  vendorBill VendorBill @relation(fields: [vendorBillId], references: [id], onDelete: Restrict)
  vendor     Vendor     @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  createdBy  User?      @relation("VendorBillPaymentCreatedBy", fields: [createdByUserId], references: [id])

  @@index([tenantId, vendorId])
  @@index([tenantId, vendorBillId])
  @@index([tenantId, paymentDate])
  @@map("vendor_bill_payments")
}

model VendorLedgerEntry {
  id            String                @id @default(cuid())
  tenantId      String
  vendorId      String
  entryType     VendorLedgerEntryType
  /// Absolute amount; BILL increases payable, PAYMENT/VOID decrease or reverse.
  amount        Decimal               @db.Decimal(12, 2)
  referenceId   String?
  referenceType String?
  notes         String?
  createdAt     DateTime              @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Restrict)

  @@index([tenantId, vendorId])
  @@index([tenantId, vendorId, createdAt])
  @@map("vendor_ledger_entries")
}

// ─── BOM / recipes (production flag) ──────────────────────────
// Stock posts happen on production complete (later). No DeliveryRunStock.

model Bom {
  id        String   @id @default(cuid())
  tenantId  String
  productId String
  name      String?
  notes     String?  @db.Text
  isActive  Boolean  @default(true)
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant    @relation(fields: [tenantId], references: [id])
  product Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  lines   BomLine[]
  productionOrders ProductionOrder[]

  @@index([tenantId])
  @@index([tenantId, productId])
  @@index([tenantId, productId, isActive])
  @@map("boms")
}

model BomLine {
  id                 String  @id @default(cuid())
  tenantId           String
  bomId              String
  rawMaterialId      String
  /// Qty of raw material per 1 output unit of finished product.
  qtyPerOutputUnit   Decimal @db.Decimal(12, 6)

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  bom         Bom         @relation(fields: [bomId], references: [id], onDelete: Cascade)
  rawMaterial RawMaterial @relation(fields: [rawMaterialId], references: [id], onDelete: Restrict)

  @@unique([bomId, rawMaterialId])
  @@index([tenantId])
  @@index([tenantId, bomId])
  @@map("bom_lines")
}

// ─── Production orders ────────────────────────────────────────
// Stock posts only on COMPLETE (Step 4). No DeliveryRunStock / SALE_OUT.

enum ProductionOrderStatus {
  DRAFT
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model ProductionOrder {
  id              String                @id @default(cuid())
  tenantId        String
  productId       String
  bomId           String
  locationId      String
  plannedQty      Decimal               @db.Decimal(12, 3)
  actualQty       Decimal?              @db.Decimal(12, 3)
  scrapQty        Decimal?              @db.Decimal(12, 3)
  varianceNote    String?               @db.Text
  scrapReason     String?               @db.Text
  cancelReason    String?               @db.Text
  status          ProductionOrderStatus @default(DRAFT)
  notes           String?               @db.Text
  startedAt       DateTime?
  completedAt     DateTime?
  createdByUserId String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  tenant      Tenant                   @relation(fields: [tenantId], references: [id])
  product     Product                  @relation(fields: [productId], references: [id], onDelete: Restrict)
  bom         Bom                      @relation(fields: [bomId], references: [id], onDelete: Restrict)
  location    StockLocation            @relation(fields: [locationId], references: [id], onDelete: Restrict)
  createdBy   User?                    @relation("ProductionOrderCreatedBy", fields: [createdByUserId], references: [id])
  consumeLines ProductionConsumeLine[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, productId])
  @@index([tenantId, createdAt])
  @@map("production_orders")
}

/// Snapshot of BOM consume math at complete time (audit / detail UI).
model ProductionConsumeLine {
  id                 String  @id @default(cuid())
  tenantId           String
  productionOrderId  String
  rawMaterialId      String
  qtyPerOutputUnit   Decimal @db.Decimal(12, 6)
  qtyConsumed        Decimal @db.Decimal(12, 3)

  tenant          Tenant          @relation(fields: [tenantId], references: [id])
  productionOrder ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  rawMaterial     RawMaterial     @relation(fields: [rawMaterialId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, productionOrderId])
  @@map("production_consume_lines")
}
